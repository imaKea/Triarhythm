rules_version = '2';

// Triarhythm Storage Rules
// Asset beatmap nằm tại: beatmaps/{beatmapId}/audio.ogg | background.jpg | video.mp4
service firebase.storage {
  match /b/{bucket}/o {
    match /beatmaps/{beatmapId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*|video/.*|image/.*');
    }
  }
}
